# Isolated real build regression: source edits and commits must update embedded
# identity without rerunning configure. No existing worktree is modified.
cmake_minimum_required(VERSION 3.21)
if(NOT DEFINED TEST_SOURCE_ROOT OR NOT DEFINED TEST_BINARY_ROOT)
  message(FATAL_ERROR "Build identity test requires source/binary roots")
endif()
find_package(Git REQUIRED)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef fixture_id)
set(fixture "${TEST_BINARY_ROOT}/${fixture_id}")
file(MAKE_DIRECTORY "${fixture}/fixtures/web")
file(WRITE "${fixture}/fixtures/web/MANIFEST.json" "{\"test_fixture\":true}\n")
file(WRITE "${fixture}/.gitignore" "/out/\n")
file(WRITE "${fixture}/probe.cpp" [=[
#include <iostream>
#include "asciiomium_build_identity.h"
int main() {
  std::cout << ASCIIOMIUM_SOURCE_REVISION << '\n'
            << ASCIIOMIUM_SOURCE_DIRTY << '\n';
}
]=])
set(project_template [=[
cmake_minimum_required(VERSION 3.21)
project(BuildIdentityFixture LANGUAGES CXX)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG "${CMAKE_BINARY_DIR}/bin")
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CMAKE_BINARY_DIR}/bin")
add_executable(identity_probe probe.cpp)
include("@HELPER@")
asciiomium_add_build_identity(identity_probe)
]=])
string(REPLACE "@HELPER@" "${TEST_SOURCE_ROOT}/cmake/BuildIdentity.cmake" project_content "${project_template}")
file(WRITE "${fixture}/CMakeLists.txt" "${project_content}")
function(run)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${fixture}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Identity test command failed: ${ARGV}\n${output}\n${error}\nFixture preserved: ${fixture}")
  endif()
  set(command_output "${output}" PARENT_SCOPE)
endfunction()
run("${GIT_EXECUTABLE}" init -q)
run("${GIT_EXECUTABLE}" add .)
run("${GIT_EXECUTABLE}" -c user.name=ASCIIomium-Test -c user.email=asciiomium-test@example.invalid commit -qm initial)
run("${GIT_EXECUTABLE}" rev-parse HEAD)
string(STRIP "${command_output}" first_revision)
set(configure "${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/out")
if(DEFINED TEST_GENERATOR AND NOT TEST_GENERATOR STREQUAL "")
  list(APPEND configure -G "${TEST_GENERATOR}")
endif()
if(DEFINED TEST_GENERATOR_PLATFORM AND NOT TEST_GENERATOR_PLATFORM STREQUAL "")
  list(APPEND configure -A "${TEST_GENERATOR_PLATFORM}")
endif()
run(${configure})
set(build "${CMAKE_COMMAND}" --build "${fixture}/out" --target identity_probe)
if(DEFINED TEST_BUILD_CONFIG AND NOT TEST_BUILD_CONFIG STREQUAL "")
  list(APPEND build --config "${TEST_BUILD_CONFIG}")
endif()
run(${build})
set(executable "${fixture}/out/bin/identity_probe")
if(EXISTS "${executable}.exe")
  set(executable "${executable}.exe")
endif()
function(expect_identity revision dirty)
  run("${executable}")
  string(REPLACE "\r" "" actual "${command_output}")
  string(STRIP "${actual}" actual)
  if(NOT actual STREQUAL "${revision}\n${dirty}")
    message(FATAL_ERROR "Stale identity: expected ${revision}/${dirty}, got ${actual}; fixture ${fixture}")
  endif()
endfunction()
expect_identity("${first_revision}" 0)
file(APPEND "${fixture}/probe.cpp" "\n// Source edit after configure.\n")
run(${build})
expect_identity("${first_revision}" 1)
run("${GIT_EXECUTABLE}" add probe.cpp)
run("${GIT_EXECUTABLE}" -c user.name=ASCIIomium-Test -c user.email=asciiomium-test@example.invalid commit -qm edited)
run("${GIT_EXECUTABLE}" rev-parse HEAD)
string(STRIP "${command_output}" second_revision)
run(${build})
expect_identity("${second_revision}" 0)
file(WRITE "${fixture}/untracked.hpp" "// Nonignored untracked source.\n")
run(${build})
expect_identity("${second_revision}" 1)
file(REMOVE "${fixture}/untracked.hpp")
run(${build})
expect_identity("${second_revision}" 0)
file(TIMESTAMP "${fixture}/out/generated/asciiomium_build_identity.h" before "%s")
run("${CMAKE_COMMAND}" -E sleep 1)
run(${build})
file(TIMESTAMP "${fixture}/out/generated/asciiomium_build_identity.h" after "%s")
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Unchanged identity rewrote generated header and forces needless recompilation")
endif()
file(REMOVE_RECURSE "${fixture}")
message(STATUS "Build identity refresh: clean -> edit -> commit -> untracked -> clean; unchanged header retained")
